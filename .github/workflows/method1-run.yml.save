ame: Method 1 - Docker Build with run commands

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
=      - name: Checkout code
        uses: actions/checkout@v4

      - name: Build Docker image
        run: docker build -t cityhospital-frontend:v1 .

      - name: Verify image exists
        run: docker images

      - name: Run container and test
        run: |
          docker run -d --name test-container -p 8080:80 cityhospital-frontend:v1
          sleep 5
          curl -I http://localhost:8080
          docker stop test-container

