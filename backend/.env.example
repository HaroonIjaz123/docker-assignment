# PostgreSQL example: postgresql+psycopg://cityhospital:change-me@localhost:5432/cityhospital
DATABASE_URL=sqlite:///./cityhospital.db
JWT_SECRET=replace-this-with-a-long-random-production-secret
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
# Optional one-time startup seed. Prefer `python scripts/create_admin.py`.
# Never commit real credentials or use a known/default password.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=use-a-secret-manager
